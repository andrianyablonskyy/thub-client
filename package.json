{
  "name": "@andrian.yablonskyy/thub-client",
  "version": "1.0.28",
  "description": "thub-client — runs on lab machines, executes test jobs against a DUT (HW) or emulator (SW)",
  "main": "src/daemon.js",
  "bin": {
    "thub-client": "./src/cli.js",
    "thub-client-daemon": "./src/daemon.js"
  },
  "scripts": {
    "start": "node src/daemon.js",
    "register": "node src/cli.js register",
    "deregister": "node src/cli.js deregister",
    "test": "node --test test/*.test.js",
    "postinstall": "node scripts/install-default-config.js && node scripts/install-systemd-unit.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@andrian.yablonskyy/thub-common": "^1.0.27",
    "commander": "^13.1.0",
    "dockerode": "^4.0.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.11.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.12.0"
  }
}
