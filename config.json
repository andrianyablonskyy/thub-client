{
  "coordinatorUrl": "https://coord.yablonskyy.com",
  "name": "lab-hw-01",
  "type": "sw",
  "labels": [],
  "groups": [],
  "joinKey": "silver-mountain-whispers-quietly-now",
  "heartbeatIntervalSec": 10,
  "longPollWaitSec": 30,
  "artifactory": {
    "tokenFile": "/etc/thub/artifactory.token",
    "allowedArtifactPrefixes": ["https://artifactory.example.com/fw-local/"]
  },
  "hw": {
    "stlinks": [
      { "path": "/dev/thub/dut1-stlink", "devpath": "3.3.4.3.1" },
      { "path": "/dev/thub/dut2-stlink", "devpath": "3.3.4.2" },
      { "path": "/dev/thub/dut3-stlink", "devpath": "3.3.4.3.4" },
      { "path": "/dev/thub/dut4-stlink", "devpath": "3.3.3.4" },
      { "path": "/dev/thub/dut5-stlink", "devpath": "3.3.4.3.3" }
    ],
    "uarts": [
      { "path": "/dev/thub/dut1-uart", "devpath": "3.3.3.2", "baudRate": 115200 },
      { "path": "/dev/thub/dut2-uart", "devpath": "3.3.4.3.2", "baudRate": 115200 },
      { "path": "/dev/thub/dut3-uart", "devpath": "3.3.2.4", "baudRate": 115200 },
      { "path": "/dev/thub/dut4-uart", "devpath": "3.3.2.2", "baudRate": 115200 },
      { "path": "/dev/thub/dut5-uart", "devpath": "3.3.2.3", "baudRate": 115200 }
    ],
    "usbs": [
      { "path": "/dev/thub/dut1-usb", "devpath": "3.2.4" },
      { "path": "/dev/thub/dut2-usb", "devpath": "3.2.3" },
      { "path": "/dev/thub/dut3-usb", "devpath": "3.3.3.3" },
      { "path": "/dev/thub/dut4-usb", "devpath": "3.2.2" },
      { "path": "/dev/thub/dut5-usb", "devpath": "3.4" }
    ],
    "relays": [{ "channel": 0, "baseUrl": "http://localhost:3000" }],
    "power": { "method": "relay" }
  },
  "sw": {
    "image": "dockerhub.io/ubuntu:minimal",
    "cpus": 1,
    "memory": "100m"
  }
}
