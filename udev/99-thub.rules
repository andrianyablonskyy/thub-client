# Stable device paths for TestHub HW Clients (README.md §8.2/§8.6).
# One Client instance handles one DUT slot, up to 8 per host (dut1..dut8) —
# replace each <SERIAL_...> placeholder with that slot's actual UART
# adapter / ST-Link probe serial number (`udevadm info -a` on the device).
#
# hw.uart.index in a Client's config resolves to the matching dut<N>-uart
# symlink below; hw.stlinkSerial still needs the real ST-Link serial (no
# index shortcut exists for it — st-flash selects probes by serial, not
# by udev path).

# ST Links maps
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3748", ATTR{devpath}=="3.3.4.3.1", SYMLINK+="dut1-stlink"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3748", ATTR{devpath}=="3.3.4.2",   SYMLINK+="dut2-stlink"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3748", ATTR{devpath}=="3.3.4.3.4", SYMLINK+="dut3-stlink"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3748", ATTR{devpath}=="3.3.3.4",   SYMLINK+="dut4-stlink"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3748", ATTR{devpath}=="3.3.4.3.3", SYMLINK+="dut5-stlink"

# FT323RL adaptors map
SUBSYSTEM=="usb", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTR{devpath}=="3.3.3.2",   SYMLINK+="dut1-uart"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTR{devpath}=="3.3.4.3.2", SYMLINK+="dut2-uart"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTR{devpath}=="3.3.2.4",   SYMLINK+="dut3-uart"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTR{devpath}=="3.3.2.2",   SYMLINK+="dut4-uart"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTR{devpath}=="3.3.2.3",   SYMLINK+="dut5-uart"

# DUT board map
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ATTR{devpath}=="3.2.4",   SYMLINK+="dut1-usb"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ATTR{devpath}=="3.2.3",   SYMLINK+="dut2-usb"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ATTR{devpath}=="3.3.3.3", SYMLINK+="dut3-usb"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ATTR{devpath}=="3.2.2",   SYMLINK+="dut4-usb"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ATTR{devpath}=="3.4",     SYMLINK+="dut5-usb"
